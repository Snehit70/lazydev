[Unit]
Description=LazyDev - Zero-config dev server proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/snehit
ExecStart=/usr/bin/env bash -lc 'export HOME=/home/snehit; export PATH=/home/snehit/.bun/bin:$PATH; exec bun /home/snehit/projects/lazydev/src/index.ts run'
Restart=always
RestartSec=5
Environment=HOME=/home/snehit
Environment="PATH=/home/snehit/.bun/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=default.target
